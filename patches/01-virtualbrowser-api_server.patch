+def do_randomize_fingerprint(bid: Union[int, str]) -> Dict[str, Any]:
+    """重新生成环境的随机指纹，并同步到 worker profile。"""
+    str_id = str(bid).strip()
+    data = read_virtual_dat()
+    users = data.get("users", [])
+    target: Optional[Dict[str, Any]] = None
+    for u in users:
+        if str(u.get("id")).strip() == str_id:
+            target = u
+            break
+    if target is None:
+        return {"success": False, "msg": f"未找到环境 ID={bid}", "data": None}
+
+    numeric_id = int(str_id) if str_id.isdigit() else 0
+    fresh = generate_default_browser_config(new_id=numeric_id, name=target.get("name"))
+    for key in _FINGERPRINT_KEYS:
+        if key in fresh:
+            target[key] = fresh[key]
+    target["timestamp"] = int(time.time() * 1000)
+
+    try:
+        write_virtual_dat(data)
+    except Exception as e:
+        return {"success": False, "msg": f"写入指纹配置失败: {e}", "data": None}
+
+    if str_id in running_browsers:
+        try:
+            instance = running_browsers.pop(str_id)
+            kill_process_tree(instance.pid)
+            update_browser_running_status_in_dat(str_id, False)
+        except Exception:
+            pass
+
+    try:
+        sync_worker_profile_files(str_id)
+    except Exception as e:
+        print(f"[Warn] 同步 worker 指纹配置失败: {e}")
+
+    return {"success": True, "msg": "指纹随机化成功", "data": target}
+
+
+def do_clear_cache(bid: Union[int, str]) -> Dict[str, Any]:
+    """清空环境的本地 HTTP/GPU 缓存（保留 Cookie、LocalStorage 与登录态）。"""
+    str_id = str(bid).strip()
+    worker_dir = VB_WORKERS_DIR / str_id
+    if not worker_dir.exists():
+        return {"success": False, "msg": f"环境 ID={bid} 的 profile 目录不存在: {worker_dir}", "data": None}
+
+    if str_id in running_browsers and running_browsers[str_id].is_alive():
+        return {"success": False, "msg": "环境正在运行，请先关闭窗口再清理缓存", "data": None}
+
+    removed = 0
+    freed_bytes = 0
+    cleaned: List[str] = []
+    for rel in _CACHE_DIR_NAMES:
+        path = worker_dir / rel
+        if not path.exists():
+            continue
+        try:
+            freed_bytes += sum(f.stat().st_size for f in path.rglob("*") if f.is_file())
+            shutil.rmtree(path, ignore_errors=True)
+            removed += 1
+            cleaned.append(rel)
+        except Exception as e:
+            print(f"[Warn] 清理缓存目录失败 {path}: {e}")
+
+    # 清理根目录下的临时缓存文件
+    for pattern in ("*.tmp", "*-journal", "*-wal"):
+        for f in worker_dir.glob(pattern):
+            try:
+                freed_bytes += f.stat().st_size
+                f.unlink()
+            except Exception:
+                pass
+
+    return {
+        "success": True,
+        "msg": f"已清理 {removed} 个缓存目录",
+        "data": {"id": str_id, "removed": removed, "cleaned": cleaned, "freed_bytes": freed_bytes},
+    }
