+async def do_is_browser_running(bid: Union[int, str]) -> Dict[str, Any]:
+    """判断指定环境是否正在运行（返回 data=True/False）。"""
+    clean_dead_browsers()
+    str_id = str(bid).strip()
+    instance = running_browsers.get(str_id)
+    if instance is not None and instance.is_alive():
+        return {"success": True, "msg": "运行中", "data": True}
+    if _pid_running_by_worker_id(str_id):
+        return {"success": True, "msg": "运行中（外部进程）", "data": True}
+    return {"success": True, "msg": "未运行", "data": False}
+
