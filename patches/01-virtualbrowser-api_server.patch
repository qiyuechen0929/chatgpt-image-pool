+def find_worker_by_id(worker_id: Union[int, str]) -> Optional[Dict[str, Any]]:
+    """按环境 ID 读取配置项。"""
+    str_id = str(worker_id).strip()
+    data = read_virtual_dat()
+    for u in data.get("users", []):
+        if str(u.get("id")).strip() == str_id:
+            return u
+    return None
+
+
+def _pid_running_by_worker_id(str_id: str) -> bool:
+    """兜底检测：扫描带 --worker-id=<id> 的遗留内核进程。"""
+    return bool(_list_worker_pids(str_id))
+
+
+def _list_worker_pids(str_id: str) -> List[int]:
+    """列出所有带 --worker-id=<id> 的内核进程 PID。
+
+    注意：Windows 11 24H2 (build 26200+) 已移除 wmic.exe，原先基于 wmic 的检测会在
+    新系统上永远返回空，导致残留窗口进程占着 profile 锁、新进程启动后直接退出
+    （提示“请在现有的浏览器会话中打开”）。这里改用 PowerShell CIM 查询，wmic 仅作兵底。
+    """
+    pids: List[int] = []
+
+    # 1) PowerShell CIM（新系统首选）
+    try:
+        ps_cmd = (
+            "Get-CimInstance Win32_Process -Filter \"Name='VirtualBrowser.exe'\" | "
+            f"Where-Object {{ $_.CommandLine -like '*--worker-id={str_id}*' }} | "
+            "Select-Object -ExpandProperty ProcessId"
+        )
+        proc = subprocess.run(
+            ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
+            capture_output=True,
+            text=True,
+            timeout=30,
+            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+        )
+        for line in (proc.stdout or "").splitlines():
+            s = line.strip()
+            if s.isdigit():
+                pids.append(int(s))
+    except Exception:
+        pass
+
+    if pids:
+        return pids
+
+    # 2) wmic 兵底（仅老系统存在）
+    try:
+        out = subprocess.check_output(
+            f'wmic process where "CommandLine like \'%-worker-id={str_id}%\'" get ProcessId',
+            shell=True,
+            text=True,
+            stderr=subprocess.DEVNULL,
+            timeout=10,
+        )
+        for line in out.splitlines():
+            s = line.strip()
+            if s.isdigit():
+                pids.append(int(s))
+    except Exception:
+        pass
+    return pids
+
+
+def _kill_worker_processes(str_id: str) -> None:
+    """结束指定环境的全部内核进程（含子进程）。"""
+    for pid in _list_worker_pids(str_id):
+        kill_process_tree(pid)
+
